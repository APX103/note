<mujoco model="luxo_lamp">
  <compiler angle="radian" coordinate="local"/>

  <option timestep="0.002" gravity="0 0 -9.81" iterations="50" solver="Newton">
    <flag warmstart="enable"/>
  </option>

  <visual>
    <global offwidth="800" offheight="600"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.9 0.9 0.95" rgb2="0.5 0.6 0.7" width="512" height="512"/>
    <mesh name="shade_mesh" file="shade.obj"/>
    <material name="mat_base" rgba="0.15 0.15 0.15 1" specular="0.3" shininess="0.3"/>
    <material name="mat_arm"  rgba="0.95 0.95 0.95 1" specular="0.2" shininess="0.2"/>
    <material name="mat_joint" rgba="0.5 0.5 0.5 1" specular="0.4" shininess="0.4"/>
    <material name="mat_head" rgba="0.9 0.85 0.6 1" specular="0.5" shininess="0.3"/>
    <material name="mat_bulb" rgba="1.0 1.0 0.8 1" emission="0.5" specular="0.1"/>
    <material name="mat_floor" rgba="0.75 0.75 0.75 1" specular="0.1" shininess="0.1"/>
  </asset>

  <default>
    <joint damping="0.1" armature="0.01" limited="true"/>
    <geom contype="1" conaffinity="1" friction="0.8 0.02 0.02" density="800"/>
    <motor ctrllimited="true" ctrlrange="-100 100"/>
    <position kp="100" kv="10"/>
  </default>

  <worldbody>
    <light directional="true" diffuse="0.6 0.6 0.6" specular="0.2 0.2 0.2" pos="2 2 4" dir="-0.3 -0.3 -1"/>
    <geom name="floor" type="plane" size="10 10 0.1" material="mat_floor"/>

    <!-- Base: the "foot" that contacts the ground.
         Cylinder radius 0.15 m (~15 cm) matches the requested lamp-foot scale.
         Mass is reduced from 4 kg to 1.5 kg so the whole lamp can actually jump. -->
    <body name="base" pos="0 0 0.06">
      <freejoint name="base_free"/>
      <geom name="base_geom" type="cylinder" size="0.15 0.025" material="mat_base" mass="1.5"/>

      <!-- Base yaw link: lets the arm rotate left/right while the base stays on the ground -->
      <body name="base_yaw_link" pos="0 0 0.05">
        <inertial pos="0 0 0" mass="0.001" diaginertia="1e-6 1e-6 1e-6"/>
        <joint name="base_yaw" type="hinge" axis="0 0 1" pos="0 0 0" range="-3.1416 3.1416"/>

        <!-- Lower arm -->
        <body name="lower_arm" pos="0 0 0">
          <geom name="lower_arm_geom" type="capsule" fromto="0 0 0.02 0 0 0.23" size="0.02" material="mat_arm" mass="0.3"/>
          <geom name="hip_hub" type="sphere" size="0.025" pos="0 0 0" material="mat_joint"/>

          <!-- Hip pitch: swing the lower arm forward/backward -->
          <joint name="hip_pitch" type="hinge" axis="0 1 0" pos="0 0 0" range="-1.5708 1.5708"/>

          <!-- Upper arm -->
          <body name="upper_arm" pos="0 0 0.23">
            <geom name="upper_arm_geom" type="capsule" fromto="0 0 0.02 0 0 0.23" size="0.018" material="mat_arm" mass="0.25"/>
            <geom name="elbow_hub" type="sphere" size="0.022" pos="0 0 0" material="mat_joint"/>

            <!-- Elbow pitch: fold/extend the arm -->
            <joint name="elbow_pitch" type="hinge" axis="0 1 0" pos="0 0 0" range="-2.7925 0.1745"/>

            <!-- Head mount / lampshade -->
            <body name="head_yaw_body" pos="0 0 0.23">
              <inertial pos="0 0 0" mass="0.001" diaginertia="1e-6 1e-6 1e-6"/>
              <!-- Head pitch: nod up/down -->
              <joint name="head_pitch" type="hinge" axis="0 1 0" pos="0 0 0" range="-1.5708 1.5708"/>

              <body name="head" pos="0 0 0">
                <!-- Head yaw: look left/right -->
                <joint name="head_yaw" type="hinge" axis="0 0 1" pos="0 0 0" range="-2.0 2.0"/>

                <!-- Frustum lampshade, attached at its side midpoint.
                     Mesh local: wide opening at z=0, narrow back at z=0.12.
                     Offset so the joint sits on the back-side surface at mid-height. -->
                <geom name="shade_geom" type="mesh" mesh="shade_mesh" pos="0.06 0 -0.06" material="mat_head" density="800"/>
                <!-- Bulb sits inside the shade, around mid-depth -->
                <geom name="bulb_geom" type="sphere" size="0.035" pos="0.06 0 0.0" material="mat_bulb" density="800"/>

                <!-- Camera in the head, looking out of the wide opening (along local -z) -->
                <camera name="head_camera" mode="fixed" pos="0.06 0 -0.04" euler="0 0 0" fovy="70"/>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <!-- Avoid self-collision at the joint hubs (parent/child adjacent links) -->
  <contact>
    <exclude body1="base" body2="lower_arm"/>
    <exclude body1="lower_arm" body2="upper_arm"/>
    <exclude body1="upper_arm" body2="head_yaw_body"/>
    <exclude body1="head_yaw_body" body2="head"/>
  </contact>

  <actuator>
    <position joint="base_yaw"  name="act_base_yaw"  kp="80"  kv="8"  ctrlrange="-3.1416 3.1416"/>
    <position joint="hip_pitch" name="act_hip_pitch" kp="120" kv="12" ctrlrange="-1.5708 1.5708"/>
    <position joint="elbow_pitch" name="act_elbow_pitch" kp="120" kv="12" ctrlrange="-2.7925 0.1745"/>
    <position joint="head_pitch" name="act_head_pitch" kp="60" kv="6" ctrlrange="-1.5708 1.5708"/>
    <position joint="head_yaw"  name="act_head_yaw"  kp="60"  kv="6"  ctrlrange="-2.0 2.0"/>
  </actuator>

  <!-- Home pose: classic Luxo Jr. crouch leaning forward (+x).
       Lower arm leans forward (hip_pitch +0.6), upper arm bends back
       (elbow_pitch -1.0), lampshade looks down at the ground ahead
       (head_pitch -0.2).  The base is raised so it drops and settles. -->
  <keyframe>
    <key name="home" qpos="0 0 0.06 1 0 0 0  0  0.6  -1.0  -0.2  0"/>
  </keyframe>
</mujoco>
